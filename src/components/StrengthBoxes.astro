---
const strengths = [
  {
    title: 'From Fixing to Touring, One Person All the Way',
    body: 'Field coordination for news, documentary, and YouTube/influencer production teams — now goes straight into your private tour.',
  },
  {
    title: 'No Middleman, Priced From the Floor',
    body: 'Rates start at real cost plus a minimal margin — nothing extra tacked on in between.',
  },
  {
    title: 'Local Knowledge, Flexible Planning',
    body: 'Tell me what you want to see, how much time you have, and what matters to your group. I will shape the route around the real details of your day.',
  },
];
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
  <h2 class="text-xl sm:text-2xl font-bold mb-8 text-center">Why Seoul Walk Tours</h2>
  <div class="grid sm:grid-cols-3 gap-6">
    {strengths.map((s) => (
      <div class="border border-stone-200 rounded-2xl p-6 bg-white">
        <h3 class="font-semibold text-teal-800 mb-2">{s.title}</h3>
        <p class="text-sm text-stone-600 leading-relaxed">{s.body}</p>
      </div>
    ))}
  </div>
</section>
