---
interface Tier {
  label: string;
  duration: string;
  price: string;
}

interface Props {
  slug: string;
  title: string;
  categoryLabel: string;
  capacity: string;
  summary: string;
  tiers: Tier[];
  image?: string;
}

const { slug, title, categoryLabel, capacity, summary, tiers, image } = Astro.props;
---

<a
  href={`/tours/${slug}`}
  class="block border border-stone-200 rounded-2xl overflow-hidden bg-white hover:shadow-lg transition-shadow"
>
  <img
    src={image ?? `/images/tours/${slug}.jpg`}
    alt={`${title} in Seoul`}
    class="h-36 w-full object-cover"
    loading="lazy"
  />
  <div class="p-5 flex flex-col gap-2">
    <div class="flex items-center justify-between gap-3">
      <span class="text-xs font-medium text-teal-700 uppercase tracking-wide">{categoryLabel}</span>
      <span class="text-xs text-stone-400">{tiers.length > 1 ? `${tiers.length} options` : 'Private'}</span>
    </div>
    <h3 class="font-semibold text-lg leading-snug">{title}</h3>
    <p class="text-sm text-stone-600">{summary}</p>
    <div class="flex flex-col gap-1 mt-2 pt-2 border-t border-stone-100 text-sm">
      {tiers.map((tier) => (
        <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,48%)] items-start gap-x-3 sm:grid-cols-[minmax(0,1fr)_auto]">
          <span class="min-w-0 text-stone-500 leading-snug">{tier.duration ? `${tier.label} · ${tier.duration}` : tier.label}</span>
          <span class="break-words text-right font-semibold text-stone-800 sm:whitespace-nowrap">{tier.price}</span>
        </div>
      ))}
    </div>
    <p class="text-xs text-stone-400 mt-1">{capacity}</p>
  </div>
</a>
