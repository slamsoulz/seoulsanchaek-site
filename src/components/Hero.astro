---
import CTAButton from './CTAButton.astro';

const slides = [
  { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Gyeongbokgung Palace in hanbok, Seoul' },
  { src: '/images/hero/5-hanok-sunset-4k.jpg', alt: 'Hanok village at sunset, Seoul' },
  { src: '/images/hero/6-gwangjang-market-4k.jpg', alt: 'Gwangjang Market street food, Seoul' },
  { src: '/images/hero/seongsu-4k.jpg', alt: 'Seongsu-dong cafe street, Seoul' },
  { src: '/images/hero/yeouido-hangang-4k.jpg', alt: 'Yeouido Hangang Park, Seoul' },
  { src: '/images/hero/hangang-park-4k.jpg', alt: 'Hangang Park, Seoul' },
  { src: '/images/hero/gwangjang-market-4k.jpg', alt: 'Gwangjang Market, Seoul' },
  { src: '/images/hero/ikseon-dong-4k.jpg', alt: 'Ikseon-dong hanok alley, Seoul' },
  { src: '/images/hero/namsan-tower-4k.jpg', alt: 'N Seoul Tower and Namsan, Seoul' },
  { src: '/images/hero/myeongdong-oliveyoung-4k.jpg', alt: 'Myeongdong shopping street, Seoul' },
  { src: '/images/hero/hongdae-busking-4k.jpg', alt: 'Hongdae street busking, Seoul' },
];
---

<section class="relative overflow-hidden text-white">
  <div class="absolute inset-0">
    {slides.map((slide) => (
      <img
        src={slide.src}
        alt={slide.alt}
        class="hero-slide absolute inset-0 w-full h-full object-cover"
      />
    ))}
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-28 flex flex-col items-start gap-6">
    <h1 class="text-3xl sm:text-5xl font-bold leading-tight max-w-2xl [text-shadow:0_2px_16px_rgba(0,0,0,0.6)]">
      Seoul, Walked Honestly
    </h1>
    <p class="text-white text-base sm:text-lg max-w-xl [text-shadow:0_1px_10px_rgba(0,0,0,0.7)]">
      Shaped by real fieldwork as a fixer and road manager, I personally guide
      private tours for individual travelers and small groups.
    </p>
    <div class="flex flex-wrap gap-3 mt-2">
      <CTAButton href="/contact" variant="primary">Contact Me</CTAButton>
      <CTAButton href="/pricing" variant="secondary" class="!bg-transparent !text-white !border-white hover:!bg-white/10">
        See Pricing
      </CTAButton>
    </div>
  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const shuffled = [...slides].sort(() => Math.random() - 0.5);
  shuffled.forEach((slide, i) => {
    slide.parentElement?.appendChild(slide);
    slide.style.animationDelay = `${i * 6}s`;
  });
</script>

<style>
  .hero-slide {
    opacity: 0;
    animation: heroFade 66s infinite;
  }

  @keyframes heroFade {
    0% { opacity: 0; }
    1.5% { opacity: 1; }
    9.1% { opacity: 1; }
    10.6% { opacity: 0; }
    100% { opacity: 0; }
  }
</style>
