---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import TripInfo from '../../components/TripInfo.astro';
import TourGallery from '../../components/TourGallery.astro';
import TourCard from '../../components/TourCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await render(tour);

const galleryByTour: Record<string, { src: string; alt: string }[]> = {
  'airport-transfer': [
    { src: '/images/tours/airport-transfer.jpg', alt: 'Airport transfer in Seoul' },
    { src: '/images/tours/airport-transfer-2.jpg', alt: 'Guest pickup at Incheon Airport' },
    { src: '/images/tours/airport-transfer-3.jpg', alt: 'Private car transfer to Seoul' },
    { src: '/images/hero/myeongdong-oliveyoung-4k.jpg', alt: 'Myeongdong in Seoul' },
    { src: '/images/hero/namsan-tower-4k.jpg', alt: 'N Seoul Tower and Namsan' },
  ],
  walking: [
    { src: '/images/tours/walking.jpg', alt: 'Walking tour in Seoul' },
    { src: '/images/hero/hangang-park-4k.jpg', alt: 'Hangang Park in Seoul' },
    { src: '/images/tours/walking-bukchon.jpg', alt: 'Bukchon Hanok Village in Seoul' },
    { src: '/images/hero/myeongdong-oliveyoung-4k.jpg', alt: 'Myeongdong in Seoul' },
    { src: '/images/hero/namsan-tower-4k.jpg', alt: 'N Seoul Tower and Namsan' },
  ],
  car: [
    { src: '/images/tours/car.jpg', alt: 'Private car tour in Seoul' },
    { src: '/images/hero/namsan-tower-4k.jpg', alt: 'N Seoul Tower and Namsan' },
    { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Seoul palace district' },
    { src: '/images/hero/hangang-park-4k.jpg', alt: 'Hangang Park in Seoul' },
    { src: '/images/hero/1-hanok-alley.jpg', alt: 'Bukchon Hanok alley in Seoul' },
  ],
  'seoul-highlight-dmz-nami': [
    { src: '/images/tours/dmz-nami.jpg', alt: 'Korean cultural site near Seoul' },
    { src: '/images/tours/dmz-nami-dmz.jpg', alt: 'DMZ and Seoul highlights tour' },
    { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Korean palace and mountain scenery' },
    { src: '/images/hero/namsan-tower-4k.jpg', alt: 'N Seoul Tower and Namsan' },
    { src: '/images/hero/5-hanok-sunset-4k.jpg', alt: 'Traditional Korean architecture' },
  ],
  'korea-seven-day-highlights': [
    { src: '/images/tours/korea-7day-main.jpg', alt: 'Gyeongju historic sites' },
    { src: '/images/tours/korea-7day-busan.jpg', alt: 'Busan coastal temple' },
    { src: '/images/hero/5-hanok-sunset-4k.jpg', alt: 'Traditional Korean architecture' },
    { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Seoul palace district' },
    { src: '/images/tours/dmz-nami-dmz.jpg', alt: 'DMZ tour' },
  ],
  'grand-south-korea': [
    { src: '/images/tours/korea-12day-main.jpg', alt: 'Jeju Island coastal scenery' },
    { src: '/images/tours/korea-12day-seoraksan.jpg', alt: 'Seoraksan National Park' },
    { src: '/images/tours/korea-7day-busan.jpg', alt: 'Busan coastal temple' },
    { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Seoul palace district' },
    { src: '/images/tours/dmz-nami-dmz.jpg', alt: 'DMZ tour' },
  ],
};

const otherTours = (await getCollection('tours'))
  .filter((t) => t.id !== tour.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const galleryImages = galleryByTour[tour.id] ?? [
  { src: tour.data.image ?? '/images/tours/car.jpg', alt: `${tour.data.title} in Korea` },
  { src: '/images/hero/4-hanbok-palace-4k.jpg', alt: 'Korean cultural scenery' },
  { src: '/images/hero/hangang-park-4k.jpg', alt: 'Seoul scenery' },
];

const priceMatch = tour.data.tiers[0]?.price.match(/[\d,]+(\.\d+)?/);
const lowestPrice = priceMatch ? priceMatch[0].replace(/,/g, '') : undefined;

const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tour.data.title,
  description: tour.data.summary,
  image: new URL(galleryImages[0].src, Astro.site).toString(),
  ...(lowestPrice
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'USD',
          price: lowestPrice,
          url: new URL(`/tours/${tour.id}`, Astro.site).toString(),
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<BaseLayout title={tour.data.title} description={tour.data.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <TourGallery title={tour.data.title} images={galleryImages} />
    <span class="text-xs font-medium text-teal-700 uppercase tracking-wide">
      {tour.data.categoryLabel}
    </span>
    <h1 class="text-3xl font-bold mt-2 mb-4">{tour.data.title}</h1>
    <p class="text-stone-600 mb-6">{tour.data.highlight}</p>

    <p class="text-sm text-stone-500 mb-4">Group size: {tour.data.capacity}</p>

    <TripInfo
      category={tour.data.category}
      capacity={tour.data.capacity}
      duration={tour.data.tiers[0]?.duration}
    />

    <div class="border border-stone-200 rounded-2xl overflow-hidden mb-8">
      <table class="w-full table-fixed text-sm">
        <thead class="bg-stone-100 text-stone-500 text-left">
          <tr>
            <th class="w-1/3 px-4 py-3">Tier</th>
            <th class="w-1/3 px-4 py-3">Duration</th>
            <th class="w-1/3 px-4 py-3">Price</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {tour.data.tiers.map((tier) => (
            <tr>
              <td class="px-4 py-3 font-medium">{tier.label}</td>
              <td class="px-4 py-3 text-stone-600">{tier.duration}</td>
              <td class="px-4 py-3 text-stone-800 font-semibold">{tier.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <article class="overflow-x-auto text-stone-700 leading-relaxed mb-10 [&_p]:mb-4 [&_strong]:font-semibold [&_strong]:text-stone-900 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 [&_table]:w-full [&_table]:min-w-[560px] [&_table]:table-fixed [&_th]:border-b [&_th]:border-stone-200 [&_th]:px-2 [&_th]:py-2 [&_th]:text-left [&_td]:align-top [&_td]:break-words [&_td]:px-2 [&_td]:py-2 [&_td]:leading-snug [&_td:last-child]:whitespace-nowrap">
      <Content />
    </article>

    <div class="border-t border-stone-200 pt-8">
      <CTAButton href={`/contact?tour=${encodeURIComponent(tour.data.title)}`}>
        {tour.data.category === 'multi-day' ? 'Check Availability' : 'Get an Exact Quote'}
      </CTAButton>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16 sm:pb-20">
    <div class="border-t border-stone-200 pt-10">
      <h2 class="text-lg font-bold mb-6">Other Tours</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherTours.map((t) => (
          <TourCard
            slug={t.id}
            title={t.data.title}
            categoryLabel={t.data.categoryLabel}
            capacity={t.data.capacity}
            summary={t.data.summary}
            tiers={t.data.tiers}
            image={t.data.image}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
