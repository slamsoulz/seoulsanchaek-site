---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import { getCollection } from 'astro:content';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Tours" description="Browse tours built around your pace.">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-bold mb-2">Tours built around your pace</h1>
    <p class="text-stone-600 mb-10">
      No fixed routes or landmark checklists — pick a duration and budget, and I'll build the day around what you want to see.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tours.map((tour) => (
        <TourCard
          slug={tour.id}
          title={tour.data.title}
          categoryLabel={tour.data.categoryLabel}
          capacity={tour.data.capacity}
          summary={tour.data.summary}
          tiers={tour.data.tiers}
        />
      ))}
    </div>
  </section>
</BaseLayout>
