---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
---

<BaseLayout title="Thank You" description="Your message has been received.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center flex flex-col items-center gap-4">
    <h1 class="text-3xl font-bold">Your message is in</h1>
    <p class="text-stone-600">I'll reply personally within 24–48 hours. Thank you.</p>
    <CTAButton href="/">Back to Home</CTAButton>
  </section>
</BaseLayout>
