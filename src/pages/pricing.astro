---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);

const faqs = [
  {
    q: "What's not included in the price?",
    a: 'What is included depends on the tour. Personal purchases, optional activities, and any items not listed in the tour description are separate. For custom or multi-day tours, the quote lists inclusions and exclusions item by item before you confirm.',
  },
  {
    q: 'How are foreign-currency payments calculated?',
    a: 'Prices are displayed in USD, with approximate KRW equivalents for reference. The final amount for payment is confirmed in writing, and foreign-currency payments are converted using a publicly available exchange rate on the payment date.',
  },
  {
    q: "What's the cancellation/change policy?",
    a: 'Please request changes or cancellations as early as possible. Before a booking is confirmed, there is no cancellation charge. After confirmation, any non-refundable costs already paid or committed—such as accommodation, transport, tickets, or partner services—may be deducted. The exact deadline, refund terms, and any applicable fees are provided with your quote and booking confirmation.',
  },
  {
    q: 'When is the price final?',
    a: 'A price becomes final when the written quote is confirmed. Custom itineraries, larger groups, distant destinations, vehicle requirements, accommodation, entrance fees, and seasonal availability can change the total, so these details are confirmed before payment.',
  },
  {
    q: 'Can I receive a receipt or invoice?',
    a: 'Yes. Please request a receipt or invoice after payment, and we can provide it for your records.',
  },
  {
    q: 'Why is this more transparent than other tour platforms?',
    a: '"No Middleman, Priced From the Floor" — real cost plus a minimal margin, nothing more. With no agency or platform fee in between, the price is simply more honest.',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout title="Pricing & FAQ" description="See the floor-based, transparent pricing structure.">
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-bold mb-4">Nothing hidden in the price</h1>
    <p class="text-stone-600 mb-10 leading-relaxed">
      Prices are shown in USD. They are built from real cost (local transport, admission, labor) plus
      a minimal operating margin. There's no middleman fee skimmed off the top.
    </p>

    {tours.map((tour) => (
      <div class="border border-stone-200 rounded-2xl overflow-hidden mb-6">
        <p class="text-xs font-medium text-teal-700 uppercase tracking-wide px-4 pt-4">{tour.data.categoryLabel}</p>
        <p class="text-sm text-stone-600 px-4 pt-1">{tour.data.summary}</p>
        <table class="w-full text-sm mt-2">
          <thead class="bg-stone-100 text-stone-500 text-left">
            <tr>
              <th class="px-4 py-3">Tier</th>
              <th class="px-4 py-3">Duration</th>
              <th class="px-4 py-3">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {tour.data.tiers.map((tier) => (
              <tr>
                <td class="px-4 py-3 font-medium">{tier.label}</td>
                <td class="px-4 py-3 text-stone-600">{tier.duration}</td>
                <td class="px-4 py-3 text-stone-800">{tier.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="text-xs text-stone-500 px-4 py-3 bg-stone-50 border-t border-stone-200 mt-2">
          <a href={`/tours/${tour.id}`} class="text-teal-700 hover:underline">See full details →</a>
        </p>
      </div>
    ))}

    <p class="text-xs text-stone-500 mb-2">
      Private car tours: fuel, tolls, and admission are included within the Seoul metro area (Seoul, Gimpo, Paju). Trips beyond the metro area, luggage limits, and additional hours are confirmed separately in the quote because the total depends on distance, time, and vehicle requirements.
    </p>
    <p class="text-xs text-stone-500 mb-10">
      USD amounts are shown for convenience and may change with the exchange rate · inclusions, taxes, and cancellation terms are confirmed in your written quote.
    </p>

    <div class="border border-stone-200 rounded-2xl p-6 mb-10">
      <h2 class="text-lg font-bold mb-3">Payment</h2>
      <p class="text-sm text-stone-700 leading-relaxed mb-2">
        Prices are displayed in USD. Payment is available in KRW, USD, EUR, or
        GBP by cash or bank transfer, including Wise transfers.
      </p>
      <p class="text-sm text-stone-700 leading-relaxed">
        The final amount and currency instructions are provided with your written
        quote. Foreign-currency payments are converted using a publicly available
        exchange rate on the payment date. Wise, bank-transfer, and payment-fee
        details are confirmed before payment; transfer and exchange fees are paid
        by the guest.
      </p>
    </div>

    <h2 class="text-xl font-bold mb-6">Frequently Asked Questions</h2>
    <div class="flex flex-col gap-4 mb-10">
      {faqs.map((item) => (
        <div class="border border-stone-200 rounded-xl p-5">
          <p class="font-medium mb-2">{item.q}</p>
          <p class="text-sm text-stone-600 leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>

    <CTAButton href="/contact">Get an Exact Quote</CTAButton>
  </section>
</BaseLayout>
