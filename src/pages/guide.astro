---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout title="Your Seoul Private Tour Guide" description="Meet Slam (Yoo il Min) — English-speaking private tour guide in Seoul with a background as an international press fixer.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-bold mb-1">I'll be your guide, personally</h1>
    <p class="text-teal-700 font-medium mb-8">Slam <span class="text-stone-400 font-normal">(Yoo il Min)</span></p>

    <div class="flex flex-col sm:flex-row gap-8 items-start">
      <img src="/images/guide.jpg" alt="Slam, your Seoulsanchaek guide" class="w-32 h-32 rounded-full object-cover flex-shrink-0" />

      <div class="flex flex-col gap-4 text-stone-700 leading-relaxed">
        <p>
          On the press side, I've worked as a fixer for international
          journalists and documentary crews on the ground in Korea —
          coordinating logistics, locations, and access under tight
          deadlines. That same work extends to YouTube and influencer
          production teams filming in Seoul. I've
          also worked as a road manager running production days for touring
          musicians, and spent time overseas heading the artist-relations
          side of an entertainment company. Field coordination is not new to
          me — it's most of my career.
        </p>
        <p>
          I've lived abroad myself — a year in San Francisco, six months
          based locally in Ho Chi Minh City — so I know what it's like to be
          a guest in someone else's city. I speak Korean and English. Before
          any of this, I spent seven years managing guest-facing hospitality
          operations, so looking after people on the ground isn't new to me
          either.
        </p>
        <p class="font-medium text-stone-900">
          I show you the neighborhoods I actually walk, the alleys I actually love.
        </p>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 h-80 sm:h-96 min-h-0">
      <img src="/images/guide-gallery/myeongdong.jpg" alt="Guiding a guest through Myeongdong" class="rounded-2xl h-full w-full object-cover" />
      <div class="grid grid-rows-[1fr_1fr] gap-3 h-full min-h-0">
        <img src="/images/guide-gallery/palace.jpg" alt="With guests at Gyeongbokgung Palace" class="rounded-2xl w-full h-full object-cover" />
        <div class="grid grid-cols-2 gap-3 h-full min-h-0">
          <img src="/images/guide-gallery/press.jpg" alt="On location with an international news crew" class="rounded-2xl w-full h-full object-cover" />
          <img src="/images/guide-gallery/airport.jpg" alt="Seeing off guests at the airport" class="rounded-2xl w-full h-full object-cover" />
        </div>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3 h-48 sm:h-56">
      <img src="/images/guide-gallery/rocky.jpg" alt="At home with Rocky" class="rounded-2xl w-full h-full object-cover" />
      <img src="/images/guide-gallery/bbq.jpg" alt="Korean BBQ with guests" class="rounded-2xl w-full h-full object-cover" />
    </div>

    <div class="mt-10 border-t border-stone-200 pt-8">
      <p class="text-sm text-stone-500 mb-4">
        From Fixing to Touring, One Person All the Way — contact me
        directly, not a company.
      </p>
      <CTAButton href="/contact">Ask Me Directly</CTAButton>
    </div>
  </section>
</BaseLayout>
