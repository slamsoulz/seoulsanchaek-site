---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout title="Your Seoul Private Tour Guide" description="Meet Slam (Yoo il Min) — an independent, English-speaking private tour guide in Seoul with a background as an international press fixer.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-bold mb-1">I'll be your guide, personally</h1>
    <p class="text-teal-700 font-medium mb-8">Slam <span class="text-stone-400 font-normal">(Yoo il Min)</span></p>

    <div class="flex flex-col sm:flex-row gap-8 items-start">
      <img src="/images/guide.jpg" alt="Slam, your Seoul Walk Tours guide" class="w-32 h-32 rounded-full object-cover flex-shrink-0" />

      <div class="flex flex-col gap-4 text-stone-700 leading-relaxed">
        <p>
          On the press side, I've worked as a fixer for international
          journalists and documentary crews on the ground in Korea —
          coordinating logistics, locations, and access under tight
          deadlines. That same work extends to YouTube and influencer
          production teams filming in Seoul. I've
          also worked as a road manager running production days for touring
          musicians, and spent time overseas heading the artist-relations
          side of an entertainment company. Field coordination is not new to
          me — it's most of my career.
        </p>
        <p>
          I've lived abroad myself — a year in San Francisco, a year
          based locally in Ho Chi Minh City — so I know what it's like to be
          a guest in someone else's city. I speak Korean and English. Before
          any of this, I spent seven years managing guest-facing hospitality
          operations, so looking after people on the ground isn't new to me
          either.
        </p>
        <p class="font-medium text-stone-900">
          I show you the neighborhoods I actually walk, the alleys I actually love.
        </p>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 h-80 sm:h-96 min-h-0">
      <img src="/images/guide-gallery/press.jpg" alt="On location with an international news crew" class="rounded-2xl h-full w-full object-cover object-[center_35%]" />
      <div class="grid grid-rows-[1fr_1fr] gap-3 h-full min-h-0">
        <img src="/images/guide-gallery/palace.jpg" alt="With guests at Gyeongbokgung Palace" class="rounded-2xl w-full h-full object-cover" />
        <div class="grid grid-cols-2 gap-3 h-full min-h-0">
          <img src="/images/guide-gallery/crew-night.jpg" alt="With a production colleague" class="rounded-2xl w-full h-full object-cover" />
          <img src="/images/guide-gallery/crew-2018.jpg" alt="Working with a production crew" class="rounded-2xl w-full h-full object-cover" />
        </div>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 h-48 sm:h-56 min-h-0 overflow-hidden">
      <img src="/images/guide-gallery/myeongdong.jpg" alt="Guiding a guest through Myeongdong" class="rounded-2xl overflow-hidden w-full h-full object-cover object-[center_30%] sm:col-span-1" />
      <img src="/images/guide-gallery/airport.jpg" alt="Seeing off guests at the airport" class="rounded-2xl overflow-hidden w-full h-full object-cover sm:col-span-2" />
    </div>

    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 min-h-0 overflow-hidden">
      <img src="/images/guide-gallery/airport-group.jpg" alt="With hip-hop artists at the airport" class="rounded-2xl w-full h-72 sm:h-80 object-cover" />
      <img src="/images/guide-gallery/peachy-group.jpg" alt="With a Korean girl group" class="rounded-2xl w-full h-72 sm:h-80 object-cover" />
    </div>

    <div class="mt-10 border-t border-stone-200 pt-8">
      <p class="text-sm text-stone-500 mb-4">
        From Fixing to Touring, One Person All the Way — contact me
        directly, not a company.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        <a
          href="https://wa.me/821044775115"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 border border-stone-200 rounded-2xl p-5 hover:shadow-lg transition-shadow"
        >
          <img src="/images/whatsapp-qr.png" alt="WhatsApp QR code" class="w-16 h-16 rounded-lg border border-stone-200" />
          <div>
            <p class="font-semibold text-stone-900">WhatsApp</p>
            <p class="text-sm text-stone-600">+82 10 4477 5115</p>
            <p class="text-xs text-teal-700">Scan or tap to chat →</p>
          </div>
        </a>
        <a
          href="mailto:seoulwalk.min@gmail.com"
          class="flex flex-col justify-center gap-1 border border-stone-200 rounded-2xl p-5 hover:shadow-lg transition-shadow"
          data-copy-email
        >
          <p class="font-semibold text-stone-900">Email</p>
          <p class="text-sm text-stone-600">seoulwalk.min@gmail.com</p>
          <p class="text-xs text-teal-700" data-copy-label>Tap to email · <span data-copy-trigger class="underline">copy instead</span></p>
        </a>
      </div>
      <CTAButton href="/contact">Ask Me Directly</CTAButton>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-copy-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        try {
          await navigator.clipboard.writeText('seoulwalk.min@gmail.com');
          const label = trigger.closest('[data-copy-email]')?.querySelector<HTMLElement>('[data-copy-label]');
          if (label) {
            const original = label.innerHTML;
            label.textContent = 'Copied!';
            setTimeout(() => { label.innerHTML = original; }, 1500);
          }
        } catch {}
      });
    });
  </script>
</BaseLayout>
