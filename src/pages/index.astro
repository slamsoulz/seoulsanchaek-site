---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StrengthBoxes from '../components/StrengthBoxes.astro';
import TourCard from '../components/TourCard.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';
import { getReviews } from '../lib/reviews';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const reviews = (await getReviews()).slice(0, 5);
---

<BaseLayout title="Seoul Walk Tours" description="Seoul Walk Tours — an independent, English-speaking private tour guide in Seoul. Private car tours, transit tours, and airport transfers, guided personally with honest, no-hidden-fee pricing.">
  <Hero />
  <StrengthBoxes />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <h2 class="text-xl sm:text-2xl font-bold mb-6 text-center">I'll Be Your Guide, Personally</h2>
    <div class="flex flex-col lg:flex-row gap-8 lg:items-start">
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start flex-1">
        <img src="/images/guide.jpg" alt="Slam, your Seoul Walk Tours guide" class="w-24 h-24 rounded-full object-cover flex-shrink-0" />
        <div class="text-center sm:text-left">
          <p class="text-teal-700 font-medium mb-2">Slam <span class="text-stone-400 font-normal">(Yoo il Min)</span></p>
          <p class="text-stone-700 leading-relaxed mb-3">
            Fixer for international press and documentary crews, road manager, seven years
            in hospitality, a year in San Francisco and a year based
            locally in Ho Chi Minh City — I show you the neighborhoods I
            actually walk, the alleys I actually love.
          </p>
          <a href="/guide" class="text-sm text-teal-700 hover:underline">Read my full story →</a>
        </div>
      </div>
      <div class="flex flex-row sm:flex-row lg:flex-col gap-3 lg:w-56 flex-shrink-0">
        <a
          href="https://wa.me/821044775115"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3 border border-stone-200 rounded-xl p-3 hover:shadow-md transition-shadow flex-1 lg:flex-none"
        >
          <img src="/images/whatsapp-qr.png" alt="WhatsApp QR code" class="w-12 h-12 rounded flex-shrink-0" />
          <div>
            <p class="text-sm font-semibold text-stone-900">WhatsApp</p>
            <p class="text-xs text-stone-500">+82 10 4477 5115</p>
          </div>
        </a>
        <a
          href="mailto:seoulwalk.min@gmail.com"
          class="flex flex-col justify-center border border-stone-200 rounded-xl p-3 hover:shadow-md transition-shadow flex-1 lg:flex-none"
          data-copy-email
        >
          <p class="text-sm font-semibold text-stone-900">Email</p>
          <p class="text-xs text-stone-500 break-all">seoulwalk.min@gmail.com</p>
          <p class="text-xs text-teal-700" data-copy-label>Tap to email · <span data-copy-trigger class="underline">copy instead</span></p>
        </a>
      </div>
    </div>

    <script>
      document.querySelectorAll<HTMLElement>('[data-copy-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          try {
            await navigator.clipboard.writeText('seoulwalk.min@gmail.com');
            const label = trigger.closest('[data-copy-email]')?.querySelector<HTMLElement>('[data-copy-label]');
            if (label) {
              const original = label.innerHTML;
              label.textContent = 'Copied!';
              setTimeout(() => { label.innerHTML = original; }, 1500);
            }
          } catch {}
        });
      });
    </script>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl sm:text-2xl font-bold">Tours & Pricing</h2>
      <a href="/tours" class="text-sm text-teal-700 hover:underline">See All →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tours.map((tour) => (
        <TourCard
          slug={tour.id}
          title={tour.data.title}
          categoryLabel={tour.data.categoryLabel}
          capacity={tour.data.capacity}
          summary={tour.data.summary}
          tiers={tour.data.tiers}
          image={tour.data.image}
        />
      ))}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl sm:text-2xl font-bold">What Guests Have Said</h2>
        <a href="/reviews" class="text-sm text-teal-700 hover:underline">See All →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {reviews.map((r) => (
          <a href="/reviews" class="block border border-stone-200 rounded-xl overflow-hidden bg-white hover:shadow-lg transition-shadow">
            <img src={r.src} alt="Guest review" class="w-full h-auto" />
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-teal-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 flex flex-col items-center text-center gap-4">
      <h2 class="text-2xl font-bold">Get an exact quote, right now</h2>
      <p class="text-teal-50 max-w-xl">
        Prices are built from real cost plus a minimal margin — no middleman fee skimmed off the top.
      </p>
      <CTAButton href="/contact" variant="secondary" class="!bg-white !text-teal-800 !border-white">
        Contact Me
      </CTAButton>
    </div>
  </section>
</BaseLayout>
