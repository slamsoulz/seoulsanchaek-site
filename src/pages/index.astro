---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StrengthBoxes from '../components/StrengthBoxes.astro';
import TourCard from '../components/TourCard.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';
import { getReviews } from '../lib/reviews';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const reviews = (await getReviews()).slice(0, 5);
---

<BaseLayout title="Home" description="Seoul Walk Tours — private car tours, transit tours, and airport transfers in Seoul, guided personally and priced honestly.">
  <Hero />
  <StrengthBoxes />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <h2 class="text-xl sm:text-2xl font-bold mb-6 text-center">I'll Be Your Guide, Personally</h2>
    <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
      <img src="/images/guide.jpg" alt="Slam, your Seoul Walk Tours guide" class="w-24 h-24 rounded-full object-cover flex-shrink-0" />
      <div class="text-center sm:text-left">
        <p class="text-teal-700 font-medium mb-2">Slam <span class="text-stone-400 font-normal">(Yoo il Min)</span></p>
        <p class="text-stone-700 leading-relaxed mb-3">
          Ex-fixer for international press and documentary crews, former road manager, seven years
          in hospitality, a year in San Francisco and six months based
          locally in Ho Chi Minh City — I show you the neighborhoods I
          actually walk, the alleys I actually love.
        </p>
        <a href="/guide" class="text-sm text-teal-700 hover:underline">Read my full story →</a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl sm:text-2xl font-bold">Tours & Pricing</h2>
      <a href="/tours" class="text-sm text-teal-700 hover:underline">See All →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tours.map((tour) => (
        <TourCard
          slug={tour.id}
          title={tour.data.title}
          categoryLabel={tour.data.categoryLabel}
          capacity={tour.data.capacity}
          summary={tour.data.summary}
          tiers={tour.data.tiers}
          image={tour.data.image}
        />
      ))}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl sm:text-2xl font-bold">What Guests Have Said</h2>
        <a href="/reviews" class="text-sm text-teal-700 hover:underline">See All →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        {reviews.map((r) => (
          <a href="/reviews" class="block border border-stone-200 rounded-xl overflow-hidden bg-white hover:shadow-lg transition-shadow">
            <img src={r.src} alt="Guest review" class="w-full h-auto" />
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-teal-800 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 flex flex-col items-center text-center gap-4">
      <h2 class="text-2xl font-bold">Get an exact quote, right now</h2>
      <p class="text-teal-50 max-w-xl">
        Prices are built from real cost plus a minimal margin — no middleman fee skimmed off the top.
      </p>
      <CTAButton href="/contact" variant="secondary" class="!bg-white !text-teal-800 !border-white">
        Contact Me
      </CTAButton>
    </div>
  </section>
</BaseLayout>
